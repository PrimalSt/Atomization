__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Секреты (OAuth-токен Директа) — только локально; шаблон — .env.example
.env

# Сгенерированные отчёты не коммитим, сама папка остаётся в репозитории
output/*
!output/.gitkeep

# Локальная история отчётов (SQLite) — у каждого пользователя своя
local_storage/

# Артефакты сборки PyInstaller (python build_exe.py)
build/
dist/
*.spec
